  "workspace": "Operation Center",
  "description": "Runs on every new alert. Reads the SentinelOne threat ID (sentinelone.threatId) from the alert's first event (any other alert stops silently), has SentinelOne fetch the threat's malware file(s) into the playbook run's storage and submits it to VMRay. Get Submission Result then waits for the analysis (up to 60 minutes), and the playbook posts the full report with screenshots as alert comments, pushes the IOCs to an IOC collection and lists the suspicious or malicious child samples found inside the file. Before use: set ioc_collection_id on 'Add IOCs to IOC Collection', and select your VMRay1 and SentinelOne accounts.",
  "nodes": {
    "0": {
      "name": "Alert Created",
      "type": "trigger",
      "outputs": {
        "default": [
          "2"
        ]
      },
      "position": {
        "x": 2100,
        "y": 1500
      },
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
      "trigger_uuid": "785583cf-4377-43ce-a5fb-f4572eb57456",
      "trigger_configuration_uuid": "ee261702-b5b4-439c-bc21-e30f00ea0c88"
    },
