{
  "name": "Alert Created - Demo Defend VMRay1",
  "uuid": "9679c108-52e4-485e-9222-1204578a3fb4",
  "tags": [
    "Alerts",
    "Enrichment",
    "VMRay",
    "SentinelOne"
  ],
  "workspace": "Operation Center",
  "description": "Runs on every new alert. Reads the SentinelOne threat ID (sentinelone.threatId) from the alert's first event (any other alert stops silently), has SentinelOne fetch the threat's malware file(s) into the playbook run's storage, submits them to VMRay (consumes quota, waits up to 30 min), posts the full report with screenshots as alert comments and pushes the IOCs to an IOC collection. Before use: set ioc_collection_id on 'Add IOCs to IOC Collection' and select your VMRay1 module configuration on the VMRay nodes.",
  "nodes": {
    "0": {
      "name": "Alert Created",
      "type": "trigger",
      "outputs": {
        "default": [
          "2"
        ]
      },
      "position": {
        "x": 2100,
        "y": 1500
      },
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
      "trigger_uuid": "785583cf-4377-43ce-a5fb-f4572eb57456",
      "trigger_configuration_uuid": "ee261702-b5b4-439c-bc21-e30f00ea0c88"
    },
    "2": {
      "name": "Get Events",
      "type": "action",
      "outputs": {
        "default": [
          "3"
        ]
      },
      "position": {
        "x": 2100,
        "y": 1972
      },
      "arguments": {
        "limit": 1,
        "query": "alert_short_ids:\"{{ node.0.short_id }}\"",
        "latest_time": "{{ node.0.last_seen_at }}",
        "earliest_time": "{{ node.0.first_seen_at }}"
      },
      "action_uuid": "af0b4355-a428-43d6-991c-d5ff878e17d5",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
      "module_configuration_uuid": null
    },
    "3": {
      "name": "SentinelOne Threat?",
      "type": "operator",
      "cases": [
        {
          "left": "{{ ((node.2['events'][0].get('sentinelone.threatId') or '') | string | length) if node.2['events'] else 0 }}",
          "name": "Yes",
          "right": "{{ 0 }}",
          "comparison": ">",
          "description": "The alert's first event carries a SentinelOne threat ID — any other alert stops here silently"
        }
      ],
      "outputs": {
        "Yes": [
          "4"
        ],
        "else": []
      },
      "subtype": "condition",
      "position": {
        "x": 2100,
        "y": 2208
      }
    },
    "4": {
      "name": "SentinelOne: Get malwares from threat",
      "type": "action",
      "outputs": {
        "default": [
          "5"
        ]
      },
      "position": {
        "x": 2100,
        "y": 2444
      },
      "arguments": {
        "timeout": 300,
        "threat_id": "{{ node.2['events'][0]['sentinelone.threatId'] }}"
      },
      "action_uuid": "3555538c-376e-4e56-8ba4-ef94e8317376",
      "module_uuid": "ff675e74-e5c1-47c8-a571-d207fc297464",
      "module_configuration_uuid": "95d91bae-3dcc-47ed-8c0d-050e83f31d56"
    },
    "5": {
      "name": "Malware Retrieved?",
      "type": "operator",
      "cases": [
        {
          "left": "{{ ((node.4.get('files') or []) | length) if node.4.get('status') == 'succeed' else 0 }}",
          "name": "Yes",
          "right": "{{ 0 }}",
          "comparison": ">",
          "description": "SentinelOne fetched the threat's file(s) from the endpoint into the playbook run's storage"
        }
      ],
      "outputs": {
        "Yes": [
          "6"
        ],
        "else": [
          "7"
        ]
      },
      "subtype": "condition",
      "position": {
        "x": 2100,
        "y": 2680
      }
    },
    "6": {
      "name": "VMRay: Submit File Sample",
      "type": "action",
      "outputs": {
        "completed": [
          "8"
        ],
        "timed_out": [
          "9"
        ],
        "submission_failed": [
          "9"
        ]
      },
      "position": {
        "x": 2100,
        "y": 2916
      },
      "arguments": {
        "files": "{{ node.4['files'] }}",
        "reanalyze": true
      },
      "action_uuid": "8edeaf02-d2c1-46d0-991c-50290ddf6a2c",
      "module_uuid": "ec8b2e5d-08be-46c5-8280-c57effcdeab2"
    },
    "7": {
      "name": "Comment Alert (Malware Not Retrieved)",
      "type": "action",
      "outputs": {
        "default": []
      },
      "position": {
        "x": 2700,
        "y": 2916
      },
      "arguments": {
        "uuid": "{{ node.0['alert_uuid'] }}",
        "author": "VMRay",
        "content": "**VMRay: no sample to analyse** — SentinelOne did not fetch the file of threat `{{ node.2['events'][0]['sentinelone.threatId'] | string | replace('`', \"'\") }}`, so nothing was sent to the sandbox and no quota was spent.\n\nSentinelOne: `{{ (node.4.get('status') or 'unknown') | string | replace('`', \"'\") }}` — {{ (node.4.get('status_reason') or 'no reason given') | string | replace('`', \"'\") }}{% if node.4.get('status') == 'succeed' %} (but no file came back){% endif %}.\n\nThe endpoint's agent must be online, and the SentinelOne API user needs the permission to fetch threat files."
      },
      "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
