        "y": 1710
      },
      "arguments": {
        "limit": 1,
        "query": "alert_short_ids:\"{{ node.0.short_id }}\"",
        "latest_time": "{{ node.0.last_seen_at }}",
        "earliest_time": "{{ node.0.first_seen_at }}"
      },
      "action_uuid": "af0b4355-a428-43d6-991c-d5ff878e17d5",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
