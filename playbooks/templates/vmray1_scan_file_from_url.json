{
  "name": "VMRay1: Scan file from URL",
  "uuid": "8537777e-23f0-4cfb-8532-369e7b570c7e",
  "tags": [
    "Alerts",
    "Enrichment",
    "VMRay1"
  ],
  "workspace": "Operation Center",
  "description": "Run by an analyst on an alert to test a file scan. Downloads the file at the URL set on 'VMRay1: Download File' (the EICAR test file by default) into the run's storage and submits it to the VMRay sandbox (consumes quota, waits up to 30 min). The full report is posted as an alert comment with its screenshot comments, and the IOCs (child samples included) are pushed to an IOC collection. Before use: select your VMRay1 module configuration on the VMRay1 nodes and set ioc_collection_id on 'Add IOCs to IOC Collection'.",
  "nodes": {
    "0": {
      "name": "Manual Trigger",
      "type": "trigger",
      "outputs": {
        "default": [
          "1"
        ]
      },
      "position": {
        "x": 2100,
        "y": 1500
      },
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
      "trigger_uuid": "fc26eb9f-b272-4c15-b3bf-ace397c0dc57"
    },
    "1": {
      "name": "VMRay1: Download File",
      "type": "action",
      "outputs": {
        "default": [
          "6"
        ]
      },
      "position": {
        "x": 2100,
        "y": 1736
      },
      "arguments": {
        "url": "https://secure.eicar.org/eicar.com.txt",
        "max_size_mb": 32
      },
      "action_uuid": "5ab13054-2833-442f-884e-9e8fba2d20ef",
      "module_uuid": "ec8b2e5d-08be-46c5-8280-c57effcdeab2"
    },
    "6": {
      "name": "VMRay: Submit File Sample",
      "type": "action",
      "outputs": {
        "completed": [
          "8"
        ],
        "timed_out": [
          "9"
        ],
        "submission_failed": [
          "9"
        ]
      },
      "position": {
        "x": 2100,
        "y": 1972
      },
      "arguments": {
        "files": "{{ node.1['files'] }}",
        "reanalyze": true
      },
      "action_uuid": "8edeaf02-d2c1-46d0-991c-50290ddf6a2c",
      "module_uuid": "ec8b2e5d-08be-46c5-8280-c57effcdeab2"
    },
    "8": {
      "name": "VMRay: Build Report",
      "type": "action",
      "outputs": {
        "default": [
          "10"
        ]
      },
      "position": {
        "x": 1800,
        "y": 3152
      },
      "arguments": {
        "submission_ids": "{{ node.6['submission_ids'] }}",
        "include_screenshots": true,
        "max_recursion_depth": 5
      },
      "action_uuid": "9689eaa4-7411-44e3-a6b8-817121c41256",
      "module_uuid": "ec8b2e5d-08be-46c5-8280-c57effcdeab2"
    },
    "9": {
      "name": "Comment Alert (Sandbox Incomplete)",
      "type": "action",
      "outputs": {
        "default": []
      },
      "position": {
        "x": 2400,
        "y": 3152
      },
      "arguments": {
        "uuid": "{{ node.0['alert_uuid'] }}",
        "author": "VMRay",
        "content": "**VMRay: sandbox analysis incomplete** — the file `{{ node.1['file_name'] | string | replace('`', \"'\") }}` (sha256 `{{ node.1['sha256'] }}`) did not return a report.{% if node.6['timed_out'] %}\n\nTimed out waiting: submission(s) {{ node.6['pending_submission_ids'] | join(', ') }} may still finish on VMRay.{% endif %}{% if node.6['failed_submission_ids'] %}\n\nFailed submission(s): {{ node.6['failed_submission_ids'] | join(', ') }}.{% endif %}{% if node.6['errors'] %}\n\nErrors:\n{% for e in node.6['errors'] %}\n- {% if e.get('file') %}file `{{ e.get('file') | string | replace('`', \"'\") }}`: {% elif e.get('submission_id') %}submission {{ e.get('submission_id') }}: {% endif %}`{{ (e.get('error_msg') or 'unknown error') | string | replace('`', \"'\") | replace('\\n', ' ') }}`{% endfor %}{% endif %}"
      },
      "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "10": {
      "name": "VMRay: Render Report",
      "type": "action",
      "outputs": {
        "default": [
          "11"
        ]
      },
      "position": {
        "x": 1800,
        "y": 3388
      },
      "arguments": {
        "report_path": "{{ node.8['report_path'] }}",
        "max_comment_kb": 512
      },
      "action_uuid": "8d9030e2-fdab-435d-b7a9-c5516a43d362",
      "module_uuid": "ec8b2e5d-08be-46c5-8280-c57effcdeab2"
    },
    "11": {
      "name": "Comment Alert (Report)",
      "type": "action",
      "outputs": {
        "default": [
          "12",
          "13"
        ]
      },
      "position": {
        "x": 1800,
        "y": 3624
      },
      "arguments": {
        "uuid": "{{ node.0['alert_uuid'] }}",
        "author": "VMRay",
        "content": "{{ node.10['content'] }}{% if node.6['errors'] %}<p><b>Not in this report</b></p><ul>{% for e in node.6['errors'] %}<li>{% if e.get('file') %}file <code>{{ e.get('file') | e }}</code>{% elif e.get('submission_id') %}submission {{ e.get('submission_id') }}{% endif %} — <code>{{ (e.get('error_msg') or 'unknown error') | e }}</code></li>{% endfor %}</ul>{% endif %}"
      },
      "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "12": {
      "name": "Screenshots?",
      "type": "operator",
      "cases": [
        {
          "left": "{{ node.10['screenshot_comments'] | length }}",
          "name": "Yes",
          "right": "{{ 0 }}",
          "comparison": ">",
          "description": "The report has no screenshot — a Foreach rejects an empty list (\"Foreach input is not a list\")"
        }
      ],
      "outputs": {
        "Yes": [
          "14"
        ],
        "else": []
      },
      "subtype": "condition",
      "position": {
        "x": 2100,
        "y": 3860
      }
    },
    "13": {
      "name": "VMRay: Extract IOCs",
      "type": "action",
      "outputs": {
        "default": [
          "16"
        ]
      },
      "position": {
        "x": 1800,
        "y": 4096
      },
      "arguments": {
        "report_path": "{{ node.8['report_path'] }}"
      },
      "action_uuid": "c75fb414-5642-4797-85fa-603502cd9bbb",
      "module_uuid": "ec8b2e5d-08be-46c5-8280-c57effcdeab2"
    },
    "14": {
      "name": "Foreach Screenshot Comment",
      "type": "operator",
      "subtype": "foreach",
      "items": "{{ node.10['screenshot_comments'] }}",
      "loop": [
        "15"
      ],
      "outputs": {
        "default": []
      },
      "position": {
        "x": 2100,
        "y": 4096
      }
    },
    "15": {
      "name": "Comment Alert (Screenshots)",
      "type": "action",
      "outputs": {
        "default": []
      },
      "position": {
        "x": 2400,
        "y": 4096
      },
      "arguments": {
        "uuid": "{{ node.0['alert_uuid'] }}",
        "author": "VMRay",
        "content": "{{ node.14.default.value }}"
      },
      "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "16": {
      "name": "Indicators to Push?",
      "type": "operator",
      "cases": [
        {
          "left": "{{ node.13['indicator_groups'] | length }}",
          "name": "Yes",
          "right": "{{ 0 }}",
          "comparison": ">",
          "description": "Extract IOCs found no indicator to push — a Foreach rejects an empty list (\"Foreach input is not a list\")"
        }
      ],
      "outputs": {
        "Yes": [
          "17"
        ],
        "else": []
      },
      "subtype": "condition",
      "position": {
        "x": 1800,
        "y": 4332
      }
    },
    "17": {
      "name": "Foreach Indicator Type",
      "type": "operator",
      "subtype": "foreach",
      "items": "{{ node.13['indicator_groups'] }}",
      "loop": [
        "18"
      ],
      "outputs": {
        "default": []
      },
      "position": {
        "x": 1800,
        "y": 4568
      }
    },
    "18": {
      "name": "Add IOCs to IOC Collection",
      "type": "action",
      "outputs": {
        "default": []
      },
      "position": {
        "x": 2100,
        "y": 4568
      },
      "arguments": {
        "valid_for": 30,
        "indicators": "{{ node.17.default.value['indicators'] }}",
        "indicator_type": "{{ node.17.default.value['type'] }}",
        "ioc_collection_id": "ioc-collection--xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
      },
      "action_uuid": "0acabc04-43b4-4564-b9b2-08b80e0e1ecf",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    }
  },
  "community_uuid": "2b44a715-e677-4489-9803-19c8e7929f85"
}